    "auto_brightness": 0.0, "auto_target": 0.45,
    "brightness": 0.0, "contrast": 1.0, "saturation": 1.0, "temperature": 0.0,
    "look_strength": 1.0, "letterbox": 0.0, "lut_strength": 1.0,
}
STRING_DEFAULTS = {"look": "none", "lut": "", "lut_preset": "none"}
APPLY_DELAY_MS = 300


def read_config():
    cfg = {**DEFAULTS, **STRING_DEFAULTS}
    try:
        for line in CONFIG_PATH.read_text().splitlines():
            key, _, value = line.partition("=")
            key, value = key.strip(), value.strip()
            if key in STRING_DEFAULTS:
                cfg[key] = value
            elif key in DEFAULTS:
                try:
                    cfg[key] = float(value)
                except ValueError:
                    pass
    except OSError:
        pass
    return cfg


def write_config(cfg):
    lines = [f"{k} = {cfg[k]:.2f}\n" for k in DEFAULTS]
    lines.append(f"look = {cfg['look']}\n")
    lines.append(f"lut_preset = {cfg['lut_preset']}\n")
    if cfg["lut"]:
        lines.append(f"lut = {cfg['lut']}\n")
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG_PATH.with_suffix(".conf.tmp")
    tmp.write_text("".join(lines))
    tmp.replace(CONFIG_PATH)  # atomic: the stream may re-read the file at any moment
    systemctl("kill", "-s", "HUP", SERVICE)


PRESETS_PATH = Path.home() / ".config" / "kinect2-webcam-presets.json"
LIMITS = {
    "exposure": (-2, 2), "gamma": (.3, 3), "mirror": (0, 1),
    "manual_exposure": (0, 1), "exposure_ms": (1, 66), "gain": (1, 4),
    "auto_brightness": (0, 1), "auto_target": (.25, .7),
