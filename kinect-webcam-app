        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3, valign=Gtk.Align.CENTER, hexpand=True)
        labels.append(Gtk.Label(label=title, xalign=0, css_classes=["heading"]))
        labels.append(Gtk.Label(label=subtitle, xalign=0, css_classes=["caption", "dim-label"]))
        content.append(labels)
        self.sign = Gtk.Image(css_classes=["section-sign"], pixel_size=16, width_request=32, height_request=32, margin_start=8)
        content.append(self.sign)
        self.toggle.set_child(content)
        header.append(self.toggle)
        if action is not None:
            header.append(action)
        self.append(header)
        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin_top=18, margin_bottom=20,
                            margin_start=20, margin_end=20, css_classes=["section-body"])
        self.body.append(group)
        self.revealer = Gtk.Revealer(transition_type=Gtk.RevealerTransitionType.SLIDE_DOWN,
                                    transition_duration=180, child=self.body)
        self.append(self.revealer)

