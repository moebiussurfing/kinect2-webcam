        lut_group = Adw.PreferencesGroup(title="Colour LUT")
        for row in (self.lut_combo, self.lut_strength_row):
            lut_group.add(row)

        # --- Image -----------------------------------------------------------------------
        self.auto_row = Adw.SwitchRow(title="Auto brightness", subtitle="Follows the room light, without clipping whites")
        self.auto_row.set_active(bool(cfg["auto_brightness"]))
        self.target_row = self._spin("Auto brightness target", "Average picture brightness to aim for.",
                                     cfg["auto_target"], 0.25, 0.7, 0.01, 2)
        self.exposure_row = self._spin("Exposure", "Camera auto-exposure compensation. Lower is darker.",
                                       cfg["exposure"], -2.0, 2.0, 0.1, 1)
        self.gamma_row = self._spin("Gamma", "Above 1 darkens midtones, below 1 lightens them.",
                                    cfg["gamma"], 0.3, 3.0, 0.05, 2)
        self.brightness_row = self._spin("Brightness", "Adds or removes light.", cfg["brightness"], -0.3, 0.3, 0.02, 2)
        self.contrast_row = self._spin("Contrast", "Separates lights and darks.", cfg["contrast"], 0.5, 1.5, 0.05, 2)
        self.saturation_row = self._spin("Saturation", "0 is black and white.", cfg["saturation"], 0.0, 2.0, 0.05, 2)
        self.temperature_row = self._spin("Temperature", "Negative is cooler, positive is warmer.",
                                          cfg["temperature"], -1.0, 1.0, 0.1, 1)
        reset = Gtk.Button(label="Reset", valign=Gtk.Align.CENTER)
        reset.connect("clicked", self.on_reset)
        image_group = Adw.PreferencesGroup(title="Image")
        image_group.set_header_suffix(reset)
        for row in (self.auto_row, self.target_row, self.exposure_row, self.gamma_row, self.brightness_row,
                    self.contrast_row, self.saturation_row, self.temperature_row):
            image_group.add(row)

        # --- Camera (manual exposure) ----------------------------------------------------
        self.manual_row = Adw.SwitchRow(title="Manual exposure", subtitle="Fixed exposure time and gain instead of auto")
        self.manual_row.set_active(bool(cfg["manual_exposure"]))
        self.ms_row = self._spin("Exposure time (ms)", "Longer is brighter but blurrier.", cfg["exposure_ms"], 1.0, 66.0, 1.0, 0)
        self.gain_row = self._spin("Gain", "Higher is brighter but noisier.", cfg["gain"], 1.0, 4.0, 0.1, 1)
        camera_group = Adw.PreferencesGroup(title="Camera")
        for row in (self.manual_row, self.ms_row, self.gain_row):
            camera_group.add(row)

        for row in (self.look_row, self.lut_combo):
            row.connect("notify::selected", self.on_image_changed)
        for row in (self.letterbox_row, self.auto_row, self.manual_row):
            row.connect("notify::active", self.on_image_changed)

        controls = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16, margin_top=12, margin_bottom=12,
                           margin_start=6, margin_end=12)
        self.group_expanders = []
        sections = [
            (webcam_group, "Stream & startup", "camera-web-symbolic", "webcam"),
            (look_group, "20 factory + your presets", "applications-graphics-symbolic", "look"),
            (lut_group, "Built-in colour grades", "color-select-symbolic", "lut"),
            (image_group, "Light & colour", "display-brightness-symbolic", "image"),
            (camera_group, "Exposure & sensor", "camera-photo-symbolic", "camera"),
        ]
        for index, (group, subtitle, icon, style) in enumerate(sections):
            section = ControlSection(group.get_title(), subtitle, icon, style, group, expanded=index < 2)
            if style == "look":
                section.body.append(self.preset_actions)
            self.group_expanders.append(section)
            controls.append(section)
        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, child=Adw.Clamp(maximum_size=460, child=controls))
        scroller.set_size_request(430, -1)

        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        body.append(preview_box)
        body.append(scroller)

        view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        self.theme_button = Gtk.ToggleButton(css_classes=["flat"], valign=Gtk.Align.CENTER)
        self.theme_icon = Gtk.Image(pixel_size=16)
        self.theme_label = Gtk.Label()
        theme_content = Gtk.Box(spacing=6)
        theme_content.append(self.theme_icon)
        theme_content.append(self.theme_label)
        self.theme_button.set_child(theme_content)
        self.theme_button.set_active(Adw.StyleManager.get_default().get_dark())
        self._update_theme_button()
        self.theme_button.connect("toggled", self.on_theme_toggled)
        self._theme_syncing = False
        self._theme_signal = Adw.StyleManager.get_default().connect("notify::dark", self._sync_theme_from_manager)
        header.pack_end(self.theme_button)
        view.add_top_bar(header)
        self.toasts = Adw.ToastOverlay(child=body)
        view.set_content(self.toasts)
        self.set_content(view)
        self.connect("close-request", self.on_close)
        self._bind_spins()  # after the initial values are set, so building the window writes nothing

        self.refresh()
        self._refresh_source = GLib.timeout_add_seconds(REFRESH_SECONDS, self.refresh)

    @staticmethod
    def _spin(title, subtitle, value, lower, upper, step, digits):
        return Adw.SpinRow(title=title, subtitle=subtitle, digits=digits,
                           adjustment=Gtk.Adjustment(value=value, lower=lower, upper=upper, step_increment=step))

    def _bind_spins(self):
        for row in (self.strength_row, self.lut_strength_row, self.target_row, self.exposure_row, self.gamma_row, self.brightness_row,
                    self.contrast_row, self.saturation_row, self.temperature_row, self.ms_row, self.gain_row):
            row.connect("notify::value", self.on_image_changed)

    def refresh(self):
        active, enabled, connected = service_active(), service_enabled(), kinect_connected()
        self._syncing = True
        self.active_row.set_active(active)
        self.login_row.set_active(enabled)
        self._syncing = False

        self.sensor_row.set_subtitle("Connected" if connected else "Not detected, check the USB 3 cable")
        if self.preview_row.get_active() and active:
            self.preview.start()
            self.preview_note.set_label("" if self.preview.has_frame else "Waiting for video…")
        else:
            self.preview.stop()
            self.picture.set_paintable(None)
            if not connected:
                self.preview_note.set_label("The Kinect is not connected.")
            elif not active:
                self.preview_note.set_label("Webcam is off.\nTurn it on to see the preview.")
            else:
                self.preview_note.set_label("Preview is off.")
        return True

    def _run_async(self, *args):
        def work():
            try:
                result = systemctl(*args)
                if result.returncode:
                    GLib.idle_add(self._message, result.stderr.strip() or "Could not change the webcam service.")
            except OSError as exc:
                GLib.idle_add(self._message, str(exc))
            GLib.idle_add(self.refresh)

        threading.Thread(target=work, daemon=True).start()

    def on_active_toggled(self, row, _param):
        if not self._syncing:
            self._run_async("start" if row.get_active() else "stop", SERVICE)

    def on_login_toggled(self, row, _param):
        if not self._syncing:
            self._run_async("enable" if row.get_active() else "disable", SERVICE)

    def on_image_changed(self, *_args):
        if self._syncing:
            return
        # Debounce: wait for the spin buttons to settle before writing and reloading.
        if self._apply_source:
            GLib.source_remove(self._apply_source)
        self._apply_source = GLib.timeout_add(APPLY_DELAY_MS, self._apply_image_settings)

    def _collect(self):
        cfg = read_config()  # keeps keys this window does not edit, such as mirror
        cfg.update({
            "exposure": self.exposure_row.get_value(), "gamma": self.gamma_row.get_value(),
            "brightness": self.brightness_row.get_value(), "contrast": self.contrast_row.get_value(),
            "saturation": self.saturation_row.get_value(), "temperature": self.temperature_row.get_value(),
            "auto_brightness": float(self.auto_row.get_active()), "auto_target": self.target_row.get_value(),
            "manual_exposure": float(self.manual_row.get_active()), "exposure_ms": self.ms_row.get_value(),
            "gain": self.gain_row.get_value(), "look_strength": self.strength_row.get_value(), "lut_strength": self.lut_strength_row.get_value(),
            "letterbox": float(self.letterbox_row.get_active()),
            "look": self._looks[self.look_row.get_selected()][0], "lut": self.lut_path,
            "lut_preset": self._luts[self.lut_combo.get_selected()][0],
        })
        return cfg

    def _apply_image_settings(self):
        self._apply_source = 0
        write_config(self._collect())
        return False

    def _message(self, message):
        self.toasts.add_toast(Adw.Toast(title=message))
        return False

    def _reload_presets(self, selected=None):
        # Model replacement/Save must never autoload a transient or newly saved entry.
        self._preset_reloading = True
        try:
            try:
                self._preset_names = sorted(read_presets(), key=str.casefold)
                error = None
            except (OSError, ValueError) as exc:
                self._preset_names = []
                error = str(exc)
            self._preset_entries = [None] + [("factory", name) for name in FACTORY_PRESETS]
            self._preset_entries += [("user", name) for name in self._preset_names]
            labels = ["Choose a preset…"] + [f"{i:02d} · {name}" for i, name in enumerate(FACTORY_PRESETS, 1)]
            labels += ["Saved · " + name for name in self._preset_names]
            self.preset_row.set_model(Gtk.StringList.new(labels))
            self.preset_row.set_tooltip_text(error or "Choose a factory or saved preset to apply it immediately.")
            self.preset_row.set_selected(self._preset_entries.index(("user", selected)) if selected in self._preset_names else 0)
        finally:
            self._preset_reloading = False
        self._sync_preset_navigation()
        if not getattr(self, "_preset_connected", False):
            self.preset_row.connect("notify::selected", self.on_preset_selected)
            self._preset_connected = True

    def _sync_preset_navigation(self):
        index = self.preset_row.get_selected()
        last = len(self._preset_entries) - 1
        self.previous_preset_button.set_sensitive(1 < index <= last)
        self.next_preset_button.set_sensitive(0 <= index < last)
        personal = 0 < index <= last and self._preset_entries[index][0] == "user"
        self.delete_preset_button.set_sensitive(personal)
        self.delete_preset_button.set_tooltip_text("Delete the selected personal preset" if personal else "Select a personal preset; factory presets cannot be deleted")

    def _step_preset(self, delta):
        index = self.preset_row.get_selected()
        target = index + delta
        if 1 <= target < len(self._preset_entries):
            self.preset_row.set_selected(target)  # Same autoload path as the dropdown; one write.

    def on_preset_selected(self, *_args):
        self._sync_preset_navigation()
        if not self._preset_reloading and not self._syncing:
            self.on_load_preset(None)

    def _update_theme_button(self):
        dark = self.theme_button.get_active()
        self.theme_icon.set_from_icon_name("weather-clear-night-symbolic" if dark else "weather-clear-symbolic")
        self.theme_label.set_label("Night" if dark else "Day")
        self.theme_button.set_tooltip_text("Switch to day mode" if dark else "Switch to night mode")
        self.theme_button.update_property([Gtk.AccessibleProperty.LABEL], ["Night mode"])

    def _sync_theme_from_manager(self, *_args):
        self._theme_syncing = True
        try:
            self.theme_button.set_active(Adw.StyleManager.get_default().get_dark())
            self._update_theme_button()
        finally:
            self._theme_syncing = False

    def on_theme_toggled(self, button):
        if self._theme_syncing:
            return
        dark = button.get_active()
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK if dark else Adw.ColorScheme.FORCE_LIGHT)
        self._update_theme_button()
        try:
            save_theme("dark" if dark else "light")
        except (OSError, ValueError) as exc:
            self._message(f"Theme changed, but could not save preference: {exc}")

    def on_delete_preset(self, _button):
        index = self.preset_row.get_selected()
        if not 0 < index < len(self._preset_entries):
            return
        origin, name = self._preset_entries[index]
        if origin != "user":
            return
        dialog = Adw.AlertDialog(heading="Delete preset?",
                                 body=f"Remove “{name}” from your saved presets? The current image will not change. A recovery copy will be kept.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("delete", "Delete preset")
        dialog.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")

        def response(_dialog, choice):
            if choice != "delete":
                return
            try:
                delete_preset(name)
            except (OSError, ValueError) as exc:
                self._message(f"Could not delete preset: {exc}")
                return
            self._reload_presets()  # Placeholder only: do not load a neighbour or change the image.
            self._message(f"Preset deleted: {name}")

        dialog.connect("response", response)
        dialog.present(self)

    def on_save_preset(self, _button):
        entry = Gtk.Entry(placeholder_text="Preset name", activates_default=True)
        dialog = Adw.AlertDialog(heading="Save preset", body="Save the current look, LUT, image and exposure settings.",
                                 extra_child=entry)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("save", "Save")
        dialog.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("save")
        dialog.set_close_response("cancel")
        dialog.set_response_enabled("save", False)
        entry.connect("changed", lambda e: dialog.set_response_enabled("save", bool(e.get_text().strip())))

        def response(_dialog, choice):
            if choice != "save":
                return
            try:
                name = save_preset(entry.get_text(), self._collect())
            except (OSError, ValueError) as exc:
                self._message(str(exc))
                return
            self._reload_presets(name)
            self._message(f"Preset saved: {name}")

        dialog.connect("response", response)
        dialog.present(self)

    def on_load_preset(self, _button):
        index = self.preset_row.get_selected()
        if not 0 < index < len(self._preset_entries):
            return
        origin, name = self._preset_entries[index]
        try:
            cfg = validate_preset(FACTORY_PRESETS[name] if origin == "factory" else read_presets()[name])
            look_ids = [i for i, _ in self._looks]
            lut_ids = [i for i, _ in self._luts]
            if cfg["look"] not in look_ids or cfg["lut_preset"] not in lut_ids + ["file"]:
                raise ValueError("This preset uses a look or LUT unavailable in this version.")
            if cfg["lut_preset"] == "file" and not Path(cfg["lut"]).is_file():
                raise ValueError("The custom LUT file is missing. Restore it before loading this preset.")
            # Write once, after all validation; do not apply intermediate widget values.
            write_config(cfg)
        except (OSError, ValueError, KeyError) as exc:
            self._message(f"Could not load preset: {exc}")
            return
        if self._apply_source:
            GLib.source_remove(self._apply_source)
            self._apply_source = 0
        self._syncing = True
        try:
            for key, row in (("exposure", self.exposure_row), ("gamma", self.gamma_row),
                             ("brightness", self.brightness_row), ("contrast", self.contrast_row),
                             ("saturation", self.saturation_row), ("temperature", self.temperature_row),
                             ("auto_target", self.target_row), ("exposure_ms", self.ms_row),
                             ("gain", self.gain_row), ("look_strength", self.strength_row),
                             ("lut_strength", self.lut_strength_row)):
                row.set_value(cfg[key])
            for key, row in (("auto_brightness", self.auto_row), ("manual_exposure", self.manual_row),
                             ("letterbox", self.letterbox_row)):
                row.set_active(bool(cfg[key]))
            self.look_row.set_selected(look_ids.index(cfg["look"]))
            if cfg["lut_preset"] == "file" and "file" not in lut_ids:
                self._luts.append(("file", "Legacy saved grade"))
                lut_ids.append("file")
                self.lut_combo.set_model(Gtk.StringList.new([label for _, label in self._luts]))
            self.lut_combo.set_selected(lut_ids.index(cfg["lut_preset"]))
            self.lut_path = cfg["lut"]
        finally:
            self._syncing = False

    def on_reset(self, _button):
        d = DEFAULTS
        for row, key in ((self.exposure_row, "exposure"), (self.gamma_row, "gamma"), (self.brightness_row, "brightness"),
                         (self.contrast_row, "contrast"), (self.saturation_row, "saturation"),
                         (self.temperature_row, "temperature"), (self.target_row, "auto_target")):
            row.set_value(d[key])
        self.auto_row.set_active(False)

    def on_close(self, *_args):
        if self._apply_source:
            GLib.source_remove(self._apply_source)
            self._apply_image_settings()
        if self._refresh_source:
            GLib.source_remove(self._refresh_source)
            self._refresh_source = 0
        self.preview.stop()
        if self._theme_signal:
            Adw.StyleManager.get_default().disconnect(self._theme_signal)
            self._theme_signal = 0
        Gtk.StyleContext.remove_provider_for_display(self.get_display(), self._css_provider)
        return False



class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        window = self.props.active_window or Window(self)
        window.present()
        if not service_active():
            window._run_async("start", SERVICE)  # Opening the GUI does not enable login autostart.


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
