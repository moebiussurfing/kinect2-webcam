    "temperature": (-1, 1), "look_strength": (0, 1), "letterbox": (0, 1),
    "lut_strength": (0, 1),
}


def validate_preset(cfg):
    if not isinstance(cfg, dict) or set(cfg) != set(DEFAULTS) | set(STRING_DEFAULTS):
        raise ValueError("The preset does not contain the expected image settings.")
    for key, (low, high) in LIMITS.items():
        value = cfg[key]
        if (type(value) not in (int, float) or not math.isfinite(value)
                or not low <= value <= high):
            raise ValueError(f"Invalid preset setting: {key}")
        if key in ("mirror", "manual_exposure", "auto_brightness", "letterbox") and value not in (0, 1):
            raise ValueError(f"Invalid switch setting: {key}")
    for key in STRING_DEFAULTS:
        value = cfg[key]
        if not isinstance(value, str) or any(ord(c) < 32 for c in value):
            raise ValueError(f"Invalid preset text: {key}")
    return dict(cfg)


def validate_preset_name(name):
    if not isinstance(name, str) or not name.strip() or len(name) > 80 or any(ord(c) < 32 for c in name):
        raise ValueError("Use a preset name of 1–80 characters.")
    return name.strip()


def read_presets():
    try:
        data = json.loads(PRESETS_PATH.read_text())
    except FileNotFoundError:
        return {}
    if not isinstance(data, dict) or data.get("version") != 1 or not isinstance(data.get("presets"), dict):
        raise ValueError("Unrecognized preset file. Your saved presets have not been changed.")
    for name, cfg in data["presets"].items():
        if validate_preset_name(name) != name:
            raise ValueError("Invalid saved preset name.")
        validate_preset(cfg)
    return data["presets"]


def save_preset(name, cfg):
    name = validate_preset_name(name)
    cfg = validate_preset(cfg)
    presets = read_presets()  # Never replace an unreadable or corrupt file.
    if name in presets:
        raise ValueError("That name already exists. Please choose a different name.")
    presets[name] = cfg
    write_json_atomic(PRESETS_PATH, {"version": 1, "presets": presets})
    return name


def write_json_atomic(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent,
                                         prefix=path.name + ".", delete=False) as out:
            tmp = Path(out.name)
            json.dump(data, out, indent=2, ensure_ascii=False, allow_nan=False)
            out.write("\n")
        tmp.replace(path)
    finally:
        if tmp is not None and tmp.exists():
            tmp.unlink()


def delete_preset(name):
    presets = read_presets()
    if name not in presets:
        raise ValueError("This personal preset no longer exists.")
    backup = PRESETS_PATH.with_name(PRESETS_PATH.name + datetime.now().strftime(".bak-%Y%m%d-%H%M%S-%f"))
    shutil.copy2(PRESETS_PATH, backup)  # Keep an exact recovery copy before removing anything.
    del presets[name]
    write_json_atomic(PRESETS_PATH, {"version": 1, "presets": presets})
    return backup


UI_SETTINGS_PATH = Path.home() / ".config" / "kinect2-webcam-ui.json"


def read_ui_settings():
    try:
        data = json.loads(UI_SETTINGS_PATH.read_text())
        if isinstance(data, dict) and data.get("version") == 1 and data.get("theme") in ("light", "dark"):
            return {"theme": data["theme"]}
    except (OSError, ValueError):
        pass
    return {}


def save_theme(theme):
    if theme not in ("light", "dark"):
        raise ValueError("Unknown theme.")
    write_json_atomic(UI_SETTINGS_PATH, {"version": 1, "theme": theme})


