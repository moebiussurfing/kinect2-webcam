        return self.toggle.get_active()

    def set_expanded(self, expanded):
        self.toggle.set_active(expanded)


class Preview:
    """Shows the frames the service publishes (already processed). Never opens the camera device,
    so other apps such as Meet can keep using it."""

    INTERVAL_MS = 20

    def __init__(self, picture):
        self.picture = picture
        self._source = 0
        self._mtime = 0
        self._touched = 0
        self.has_frame = False

    def start(self):
        if self._source:
            return
        self._touch_want()
        self._source = GLib.timeout_add(self.INTERVAL_MS, self._tick)

    def stop(self):
        if self._source:
            GLib.source_remove(self._source)
            self._source = 0
        self.has_frame = False
        self._mtime = 0
        try:
            WANT_FILE.unlink()
        except OSError:
            pass

    @staticmethod
    def _touch_want():
        try:
            WANT_FILE.touch()  # the service publishes frames only while this file is fresh
        except OSError:
            pass

    def _tick(self):
        now = GLib.get_monotonic_time()
        if now - self._touched > 1_000_000:
            self._touch_want()
            self._touched = now
        try:
            mtime = PREVIEW_FILE.stat().st_mtime_ns
            if mtime != self._mtime:
                self._mtime = mtime
                data = PREVIEW_FILE.read_bytes()
                if data[:4] == b"KWP1":
                    w, h = struct.unpack_from("<II", data, 4)
                    if len(data) >= 16 + w * h * 3:
                        pixels = GLib.Bytes.new(data[16:16 + w * h * 3])
                        self.picture.set_paintable(
                            Gdk.MemoryTexture.new(w, h, Gdk.MemoryFormat.R8G8B8, pixels, w * 3))
                        self.has_frame = True
        except OSError:
            pass
        return True


